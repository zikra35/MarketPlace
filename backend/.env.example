# Copy to backend/.env and fill in real values.
# Atlas: Database > Connect > Drivers. Put your DB user's password after the colon
# and a database name after ".net/" (e.g. /marketplace). URL-encode special characters
# in the password (@ -> %40, # -> %23, / -> %2F).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marketplace?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
PORT=5000
NODE_ENV=development

# Only for `npm test` - the tests DELETE all data in this database, never point it at real data
# MONGODB_TEST_URI=mongodb://localhost:27017/marketplace-test

# --- Production (Railway) only ---
# Your Vercel address, so the API accepts requests from it
# FRONTEND_URL=https://your-app.vercel.app
# NODE_ENV=production
